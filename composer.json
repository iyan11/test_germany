{
  "name": "viosk/ebay-flat-generator",
  "description": "Production-grade PHP CLI app to generate eBay Germany flat files from XLSX template",
  "type": "project",
  "require": {
    "php": "^8.2",
    "ext-mbstring": "*",
    "ext-json": "*",
    "guzzlehttp/guzzle": "^7.9",
    "phpoffice/phpspreadsheet": "^2.1",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.2"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "find src bin -name '*.php' -print0 | xargs -0 -n1 php -l"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "license": "proprietary"
}
